rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Server-only rate-limiting buckets written exclusively by Cloud Functions (Admin SDK).
    // Client reads and writes are explicitly denied.
    match /_rateLimits/{doc} {
      allow read, write: if false;
    }

    // Default deny for all other client Firestore access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
