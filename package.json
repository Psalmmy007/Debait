{
  "name": "debait",
  "version": "0.1.0",
  "private": true,
  "description": "Nutrition facts for your feed. A Chrome extension that tags and rewrites bait headlines.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "fonts": "node scripts/copy-fonts.js",
    "build": "npm run fonts && vite build",
    "watch": "npm run fonts && vite build --watch",
    "demo": "vite --config demo/vite.config.js --open"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "vite": "6.4.6"
  }
}
