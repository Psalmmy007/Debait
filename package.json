{
  "name": "debait",
  "version": "0.1.0",
  "private": true,
  "description": "Nutrition facts for your feed. A Chrome extension that tags and rewrites bait headlines.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "fonts": "node scripts/copy-fonts.js",
    "build": "npm run fonts && vite build",
    "watch": "npm run fonts && vite build --watch",
    "demo": "vite --config demo/vite.config.js --open",
    "dev": "vite --config vite.web.config.js",
    "build:web": "vite build --config vite.web.config.js"
  },
  "dependencies": {
    "firebase": "^13.3.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "vite": "6.4.6"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
